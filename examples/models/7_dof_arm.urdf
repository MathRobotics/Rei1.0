  <joint name="joint6" type="revolute"><parent link="arm5"/><child link="arm6"/><origin xyz="0 0 0.1"/><axis xyz="0 0 1"/></joint>
  <joint name="joint7" type="revolute"><parent link="arm6"/><child link="end_effector"/><origin xyz="1 0 0"/><axis xyz="0 0 1"/></joint>
